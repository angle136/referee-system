{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure armor Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware/armor_subboard_g030"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: build armor Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware/armor_subboard_g030"
            },
            "dependsOn": "CMake: configure armor Debug",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}
